---
import FormattedDate from './FormattedDate.astro';

interface Props {
  class?: string
  post: {
    slug: string;
    title: string;
    description: string;
    pubDate: Date;
    minutesRead: number;
  };
}

const {class: className, post} = Astro.props;
---

<a
    href={`/blog/${post.slug}/`}
    class:list={['block py-4 px-4 -mx-4 rounded-lg hover:bg-neutral-50 dark:hover:bg-neutral-900/50', className]}
>
  <div
      class="font-mono mb-2 flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400"
  >
    <FormattedDate date={post.pubDate}/>
    <span class="text-neutral-300 dark:text-neutral-600">·</span>
    <span>{post.minutesRead === 1 ? `${post.minutesRead} minute read` : `${post.minutesRead} minutes read`}</span>
  </div>
  <h2
      class="font-display text-xl leading-snug font-semibold tracking-tight text-neutral-900 dark:text-neutral-50"
  >
    {post.title}
  </h2>
  <p class="mt-2 text-base leading-relaxed text-neutral-700 dark:text-neutral-300">
    {post.description}
  </p>
</a>
