---
interface Props {
  href: string;
  active: boolean;
}

const {href, active} = Astro.props;
---

<a
  href={href}
  class:list={[
    'text-sm font-medium transition-colors',
    active
      ? 'text-neutral-900 dark:text-neutral-50'
      : 'text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200',
  ]}
>
  <slot/>
</a>
