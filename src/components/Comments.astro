---
import { getEntry } from 'astro:content';

interface Props {
	class?: string
}

const {class: className} = Astro.props;

const profile = await getEntry('about', 'profile');
const { socials } = profile!.data;
const discussions = socials.github;
---

<div class={className}>
	<div
		class="mb-4 text-xs font-medium tracking-wider text-neutral-400 uppercase dark:text-neutral-500"
	>
		Comments
	</div>
	<div
		class="rounded-lg border border-neutral-100 bg-neutral-50 p-6 text-center dark:border-neutral-800 dark:bg-neutral-900"
	>
		<p class="m-0 text-sm text-neutral-700 dark:text-neutral-300">
			Got thoughts? Reply on
			<a
				href={discussions}
				class="text-neutral-900 underline-offset-2 hover:underline dark:text-neutral-50"
				>GitHub Discussions</a
			>
			or send me an email
		</p>
	</div>
</div>
