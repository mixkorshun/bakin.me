---
import Container from '../components/Container.astro';
import Layout from '../layouts/Layout.astro';
import {SITE_TITLE} from '../site-information.ts';
---

<Layout
    title={`Page not found - ${SITE_TITLE}`}
    description="The page you're looking for doesn't exist."
>
  <Container as="section" class="pt-8 md:pt-16">
    <h1 class="mb-2 font-display text-4xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
      404
    </h1>

    <p class="font-display text-xl font-normal tracking-tight text-neutral-500 dark:text-neutral-400">
      This page doesn't exist.
    </p>

    <div class="mt-8">
      <a
          href="/"
          class="text-sm text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
      >
        ← Back to homepage
      </a>
    </div>
  </Container>
</Layout>
